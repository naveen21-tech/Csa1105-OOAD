@startuml
left to right direction
title Salon / Beauty Parlour Reservation System - Use Case Diagram
actor "Customer" as A_Customer
actor "Beautician" as A_Beautician
actor "Admin" as A_Admin
rectangle "Salon / Beauty Parlour Reservation System" {
  usecase "Login" as U_Login
  usecase "Manage Beautician Availability" as U_Manage_Beautician_Availability
  usecase "View Beautician Availability" as U_View_Beautician_Availability
  usecase "Book Appointment" as U_Book_Appointment
  usecase "Confirm Booking" as U_Confirm_Booking
  usecase "Update Customer Record" as U_Update_Customer_Record
  usecase "Update Beautician Schedule" as U_Update_Beautician_Schedule
  usecase "Cancel Appointment" as U_Cancel_Appointment
  usecase "View Appointments" as U_View_Appointments
}
A_Customer --> U_Login
A_Beautician --> U_Login
A_Admin --> U_Login
A_Beautician --> U_Manage_Beautician_Availability
A_Admin --> U_Manage_Beautician_Availability
A_Customer --> U_View_Beautician_Availability
A_Customer --> U_Book_Appointment
A_Admin --> U_Confirm_Booking
A_Customer --> U_Cancel_Appointment
A_Customer --> U_View_Appointments
A_Beautician --> U_View_Appointments
U_Book_Appointment ..> U_View_Beautician_Availability : <<include>>
U_Book_Appointment ..> U_Confirm_Booking : <<include>>
U_Confirm_Booking ..> U_Update_Customer_Record : <<include>>
U_Confirm_Booking ..> U_Update_Beautician_Schedule : <<include>>
U_Cancel_Appointment ..> U_Book_Appointment : <<extend>>
@enduml
